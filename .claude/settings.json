{
  "env": {},
  "permissions": {
    "deny": [
      "Read(./package-lock.json)",
      "Read(./node_modules/**)",
      "Read(./.DS_Store)"
    ]
  },
  "enabledPlugins": {
    "weblapp-base@weblapp-kit": true
  },
  "$weblapp_profile": {
    "profile": "base",
    "lines": [],
    "by": "weblapp-profile -- do not edit; rerun with a profile"
  }
}
